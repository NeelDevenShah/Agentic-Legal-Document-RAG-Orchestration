# Required: set one provider API key.
GROQ_API_KEY='your_api_key_here'
GOOGLE_API_KEY='your_api_key_here'
OPENROUTER_API_KEY='your_api_key_here'

# Required: pick the active provider and model.
MODEL_PROVIDER=openrouter
MODEL_NAME=google/gemma-4-26b-a4b-it:free
EMBEDDING_MODEL_NAME=nvidia/nemotron-3-embed-1b:free

# Optional runtime defaults.
DATA_DIR=data
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
TOP_K=5
RETRY_ATTEMPTS=4
MODEL_TEMPERATURE=0
DEFAULT_QUESTION=Summarize the most important issues, parties, and recurring themes in the provided documents.