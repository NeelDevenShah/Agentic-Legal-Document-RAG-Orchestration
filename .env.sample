OPENAI_API_KEY=your_openai_api_key_here

MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.4-mini

EMBEDDING_MODEL_NAME=text-embedding-3-small

# Qdrant vector DB settings.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=.qdrant
QDRANT_COLLECTION_NAME=virallens_corpus

# Optional runtime defaults.
DATA_DIR=data
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
TOP_K=5
# Exponential-backoff retry attempts for LLM and embedding API calls.
RETRY_ATTEMPTS=4
# Embedding indexing: chunks per API request, and max concurrent requests.
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CONCURRENCY=2
DEFAULT_QUESTION=Summarize the most important issues, parties, and recurring themes in the provided documents.

# Optional: Jina reranker applied on top of fused BM25+semantic candidates.
# Leave JINA_API_KEY empty to skip reranking.
JINA_API_KEY=
JINA_RERANKER_MODEL=jina-reranker-v3
RERANK_CANDIDATE_MULTIPLIER=4
