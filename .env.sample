# Required: set the chat provider API key (groq or openai).
GROQ_API_KEY='your_api_key_here'
# Required for OpenAI chat and for embeddings.
OPENAI_API_KEY='your_api_key_here'

# Required: pick the active chat provider (groq or openai) and model.
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.4-mini
# Embeddings use OpenAI and require OPENAI_API_KEY (set above).
EMBEDDING_MODEL_NAME=text-embedding-3-small

# Qdrant vector DB settings.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=.qdrant
QDRANT_COLLECTION_NAME=virallens_corpus

# MySQL persistence settings for messages, sessions, and memory.
MYSQL_URL=
MYSQL_MESSAGES_TABLE=messages
MYSQL_SESSIONS_TABLE=sessions
MYSQL_MEMORY_TABLE=memory_entries

# Optional runtime defaults.
DATA_DIR=data
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
TOP_K=5
# Exponential-backoff retry attempts for LLM and embedding API calls.
RETRY_ATTEMPTS=4
# Embedding indexing: chunks per API request, and max concurrent requests.
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_CONCURRENCY=4
MODEL_TEMPERATURE=0
DEFAULT_QUESTION=Summarize the most important issues, parties, and recurring themes in the provided documents.